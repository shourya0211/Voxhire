# Copy this file to .env and fill in values.
# Never commit .env or paste keys into source files.

HUNAR_API_KEY=
HUNAR_BASE_URL=https://api.voice.hunar.ai/external/v1

# Optional people-search providers. Leave blank to use the built-in talent graph.
PDL_API_KEY=
APOLLO_API_KEY=

# Public HTTPS origin of this backend, used as Hunar webhook callbacks.
# Example: https://voxhire-api.example.com
CALLBACK_BASE_URL=

# Optional WhatsApp / SMS fallback (Twilio). Leave blank to queue messages locally.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./data/voxhire.db
